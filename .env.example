# Copy to .env (repo root). The app runs without any of these, using fixed templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_STT_MODEL=saaras:v3
# Optional: Sarvam tools MCP endpoint, attached to the chat agent when set
SARVAM_MCP_URL=
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
