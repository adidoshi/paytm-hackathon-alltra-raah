# Copy to .env (repo root). The app runs without any of these, using fixed templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_STT_MODEL=saaras:v4
# Voices per language (defaults shown). SARVAM_TTS_SPEAKER sets one voice for all three.
SARVAM_SPEAKER_EN=shubh_enhi_banking
SARVAM_SPEAKER_HI=shubh_enhi_banking
SARVAM_SPEAKER_MR=nilesh_mr_conversation
SARVAM_TTS_SPEAKER=
# Who phrases the rejection explanation: sarvam (Sarvam-105B) or gemini
EXPLAIN_LLM=sarvam
# Ask Raah agent: sarvam (Sarvam-105B) or gemini; the other is the fallback
AGENT_LLM=sarvam
# 1 = attach Sarvam MCP tools (uvx sarvam-mcp) to the Ask Raah agent
SARVAM_MCP=1
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
